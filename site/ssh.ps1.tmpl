# Shinphony: turn on Windows' OpenSSH Server, then show its status.
# Served by https://shinphony.app/ssh.ps1. The sha256 values below were taken
# from Shinphony's signed release metadata and verified before this script was
# sent, so the downloaded helper is checked against exactly what that release
# signed.
# Release: @@SEQUENCE@@
#
# Safe to run any number of times: when OpenSSH Server is already on and the
# firewall rule is enabled it asks nothing and changes nothing.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

# The advertised command is `irm ... | iex`, so this runs inside the user's own
# window: it must never call `exit`, which would close it. Stop-Setup throws a
# marked message that the top-level catch prints, and the whole body lives in one
# script block so a `return` leaves only this setup.
function Stop-Setup($message) { throw ('shinphony_setup_stopped: ' + $message) }

# Windows PowerShell 5.1 (.NET Framework) has GetAccessControl/SetAccessControl
# on DirectoryInfo; PowerShell 7 (.NET) only has them as FileSystemAclExtensions
# static methods. Both take the same sections, so the access-only write is the same.
function Get-FolderAcl($folder, $sections) {
  if ($folder.PSObject.Methods['GetAccessControl']) { return $folder.GetAccessControl($sections) }
  return [System.IO.FileSystemAclExtensions]::GetAccessControl($folder, [System.Security.AccessControl.AccessControlSections]$sections)
}
function Set-FolderAcl($folder, $acl) {
  if ($folder.PSObject.Methods['SetAccessControl']) { $folder.SetAccessControl($acl); return }
  [System.IO.FileSystemAclExtensions]::SetAccessControl($folder, $acl)
}

try {
& {
$windowsAmd64 = '@@WINDOWS_AMD64@@'
$windowsArm64 = '@@WINDOWS_ARM64@@'
$downloads = '@@DOWNLOAD_BASE@@'

# The platform decides which verified hash and download this run may use.
$platform = switch ($env:PROCESSOR_ARCHITECTURE) {
  'AMD64' { 'windows-amd64' }
  'ARM64' { 'windows-arm64' }
  default { Stop-Setup 'Shinphony setup supports Windows on x64 and arm64.' }
}
$expected = if ($platform -eq 'windows-amd64') { $windowsAmd64 } else { $windowsArm64 }
if ($expected -notmatch '^[0-9a-f]{64}$') {
  Stop-Setup 'This installer is not from a verified release. Get a new one from https://shinphony.app/ssh.ps1'
}

$dest = Join-Path $env:USERPROFILE '.shinphony-agent'
$binary = Join-Path $dest ("shinphony-hook-$expected.exe")
$me = [System.Security.Principal.WindowsIdentity]::GetCurrent()
$repair = 'In an administrator PowerShell run: icacls "' + $dest + '" /setowner "' + $me.Name + '" /T /C  then run this command again.'

# The helper belongs to the user who runs this: a private directory, never a
# link, and an existing file is reused only when its hash matches exactly.
if (-not (Test-Path -LiteralPath $dest)) { New-Item -ItemType Directory -Path $dest | Out-Null }
$dir = Get-Item -LiteralPath $dest -Force
if ($dir.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {
  Stop-Setup 'Refusing to use a linked .shinphony-agent.'
}
# Who owns the folder decides whether this can go on. A non-elevated process
# never changes an owner: that needs SeRestorePrivilege, and an owner it cannot
# write is exactly what made the next run fail with SeSecurityPrivilege. An
# elevated administrator process creates the folder owned by
# BUILTIN\Administrators instead of by the user, which for an administrator
# account is the same trust boundary (that account can take ownership anyway) and
# which the helper hands back to the user when it runs elevated; a standard user
# must still own the folder itself.
$owner = (Get-FolderAcl $dir 'Owner').GetOwner([System.Security.Principal.SecurityIdentifier])
$isAdmin = @($me.Groups | Where-Object { $_.Value -eq 'S-1-5-32-544' }).Count -gt 0
if ($owner.Value -ne $me.User.Value -and -not ($isAdmin -and $owner.Value -eq 'S-1-5-32-544')) {
  Stop-Setup ('The .shinphony-agent folder belongs to another account. ' + $repair)
}
# Access section only: no owner and no SACL is read or written, so this needs no
# administrator rights. Entries for anyone else are dropped; the folder ends up
# with one rule, for you.
$acl = Get-FolderAcl $dir 'Access'
$acl.SetAccessRuleProtection($true, $false)
# GetAccessRules, not the .Access property: PowerShell 7 does not add .Access to
# an ACL that came from FileSystemAclExtensions, and @($null) is one null rule.
# Rules come back as SIDs, so nothing needs translating.
$sidType = [System.Security.Principal.SecurityIdentifier]
foreach ($rule in @($acl.GetAccessRules($true, $false, $sidType))) {
  if ($null -eq $rule) { continue }
  if ($rule.IdentityReference.Value -ne $me.User.Value) { $acl.RemoveAccessRuleSpecific($rule) | Out-Null }
}
$acl.AddAccessRule([System.Security.AccessControl.FileSystemAccessRule]::new($me.User, 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Allow'))
try {
  Set-FolderAcl $dir $acl
} catch {
  Stop-Setup ('Could not set the permissions of the .shinphony-agent folder. ' + $repair)
}

if (Test-Path -LiteralPath $binary) {
  if ((Get-FileHash -LiteralPath $binary -Algorithm SHA256).Hash.ToLower() -ne $expected) {
    Stop-Setup 'The installed helper is not this verified release. Move it away and run this again.'
  }
  Write-Host "Shinphony: reusing the installed helper ($platform)."
} else {
  Write-Host "Shinphony: installing helper ($platform)..."
  $work = Join-Path ([System.IO.Path]::GetTempPath()) ('shinphony-ssh-' + [System.Guid]::NewGuid().ToString('N'))
  New-Item -ItemType Directory -Path $work | Out-Null
  try {
    $file = Join-Path $work 'helper.exe'
    Invoke-WebRequest -UseBasicParsing -Uri "$downloads/agent/targets/agent/$expected.$platform" -OutFile $file
    if ((Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLower() -ne $expected) {
      Stop-Setup 'The downloaded helper does not match the verified release. Nothing installed.'
    }
    # Move refuses an existing path, so nothing is ever overwritten.
    [System.IO.File]::Move($file, $binary)
  } finally {
    Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
  }
}

function Get-SSHDStatus {
  $raw = & $binary windows-sshd status
  if ($LASTEXITCODE -ne 0 -or -not $raw) {
    Stop-Setup 'Could not check OpenSSH Server. Run this again from a normal PowerShell window.'
  }
  return (($raw -join "`n") | ConvertFrom-Json)
}

# One readable line from the helper's status JSON.
function Format-SSHDStatus($status) {
  $state = if ($status.running) { 'on' } else { 'off' }
  $start = if ($status.startType) { $status.startType } else { 'not installed' }
  $firewall = if (-not $status.firewall.exists) {
    'missing'
  } elseif ($status.firewall.enabled) {
    [string]$status.firewall.profile
  } else {
    ([string]$status.firewall.profile) + ', disabled'
  }
  return "OpenSSH Server is $state ($start). Firewall: $firewall."
}

$status = Get-SSHDStatus
$needsAdmin = (-not $status.running) -or (-not $status.firewall.exists) -or (-not $status.firewall.enabled)
if ($needsAdmin) {
  Write-Host 'Shinphony needs administrator permission to turn on OpenSSH Server.'
  $answer = Read-Host 'Continue? [Y/n]'
  if ($answer -eq '' -or $answer -match '^(?i)y(es)?$') {
    # The log is created here, before elevation, so it is yours; the elevated
    # window only appends to it and this window prints it when the step fails.
    $log = Join-Path ([System.IO.Path]::GetTempPath()) ('shinphony-elevated-' + [System.Guid]::NewGuid().ToString('N') + '.log')
    New-Item -ItemType File -Path $log | Out-Null
    $logQuoted = $log -replace "'", "''"
    # One UAC prompt, and no script on disk: the elevated window receives the
    # fixed command as -EncodedCommand (UTF-16LE base64) and stays open when the
    # enable step fails, so its sentence can be read.
    $quoted = $binary -replace "'", "''"
    $command = @"
`$ErrorActionPreference = 'Stop'
`$log = '$logQuoted'
`$failed = `$false
try {
  & '$quoted' windows-sshd enable *>> `$log
  if (`$LASTEXITCODE -ne 0) { throw 'OpenSSH Server could not be turned on.' }
} catch {
  `$_ | Out-File -LiteralPath `$log -Append -Encoding UTF8
  Write-Host `$_.Exception.Message -ForegroundColor Red
  `$failed = `$true
}
if (`$failed) {
  Add-Content -LiteralPath `$log -Value 'shinphony_elevated=failed'
  Read-Host 'Press Enter to close this window.'
}
"@
    $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))
    try {
      Start-Process -FilePath 'powershell.exe' -Verb RunAs -Wait -ArgumentList @('-NoProfile', '-EncodedCommand', $encoded) | Out-Null
    } catch {
      Remove-Item -LiteralPath $log -Force -ErrorAction SilentlyContinue
      Stop-Setup 'Administrator permission was not given, so nothing changed.'
    }
    $report = ''
    if (Test-Path -LiteralPath $log) { $report = [System.IO.File]::ReadAllText($log) }
    Remove-Item -LiteralPath $log -Force -ErrorAction SilentlyContinue
    if ($report.Contains('shinphony_elevated=failed')) {
      Write-Host 'What the administrator window reported:' -ForegroundColor Red
      Write-Host $report
      Stop-Setup 'OpenSSH Server could not be turned on. Run this again from a normal PowerShell window.'
    }
    if (-not $report) {
      Stop-Setup 'Administrator permission was not given, so nothing changed.'
    }
    $status = Get-SSHDStatus
  } else {
    Write-Host 'Nothing changed.'
    return
  }
}
Write-Host (Format-SSHDStatus $status)
}
} catch {
  $text = "$($_.Exception.Message)"
  if ($text.StartsWith('shinphony_setup_stopped: ')) {
    Write-Host $text.Substring(25) -ForegroundColor Red
  } else {
    Write-Host $text -ForegroundColor Red
  }
}